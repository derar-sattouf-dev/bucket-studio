# Bucket Studio configuration — copy to .env (or run ./scripts/init-env.sh).
# Full reference: docs/configuration.md

# ── Required ──────────────────────────────────────────────────────────────────
# At least 32 characters: openssl rand -hex 32
JWT_SECRET=
# Built-in admin account
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Second password asked for sensitive admin actions
ADMIN_PASSWORD=

# ── Storage (any S3-compatible service) ───────────────────────────────────────
# The dev stack runs MinIO and overrides the endpoints; for production use your provider's endpoint,
# e.g. https://s3.eu-central-1.amazonaws.com or https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bucket-studio
S3_REGION=us-east-1
# Canned ACL for written images (e.g. public-read); leave empty for buckets with ACLs disabled
S3_OBJECT_ACL=

# Bucket layout (can be changed later in Settings → Storage & publishing)
SOURCE_PREFIX=images/
OUTPUT_PREFIX=processed/
BACKUP_PREFIX=backup/

# ── Optional AI engines ───────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Optional: production stack ────────────────────────────────────────────────
# BIND_ADDRESS=127.0.0.1
# HTTP_PORT=3000
# REAL_IP_FROM=172.17.0.1/32
# API_DOCS_ENABLED=false
